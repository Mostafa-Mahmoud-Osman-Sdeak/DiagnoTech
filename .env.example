# Copy to .env or export in the shell. All values are optional.
# Retrieval
DIAGNOTECH_TOP_K=5
DIAGNOTECH_SIMILARITY_THRESHOLD=0.45
DIAGNOTECH_EMBEDDING_MODEL=intfloat/multilingual-e5-small
DIAGNOTECH_EMBEDDING_BACKEND=auto
# Generation: auto | local | openai-compatible | none
DIAGNOTECH_LLM_PROVIDER=auto
DIAGNOTECH_LLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct
DIAGNOTECH_LLM_MAX_NEW_TOKENS=512
# Optional OpenAI-compatible endpoint (e.g. a local llama.cpp server at
# http://127.0.0.1:8080/v1, or a gateway you have an account with).
# Never commit a real API key to version control.
DIAGNOTECH_OPENAI_BASE_URL=
DIAGNOTECH_OPENAI_API_KEY=
DIAGNOTECH_OPENAI_MODEL=
# Trusted external research when the local KB cannot answer
DIAGNOTECH_EXTERNAL_RESEARCH=1
# Server
DIAGNOTECH_HOST=127.0.0.1
DIAGNOTECH_PORT=8000
